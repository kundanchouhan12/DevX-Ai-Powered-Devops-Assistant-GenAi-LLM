{
  "name": "ai-devops-assistant",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:frontend\" \"npm:backend\" \"npm:worker\" \"npm:redis\"",
    "dev:build": "docker compose up --build",
    "down": "docker compose down",

    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && node server.js",
    "worker": "cd worker && node worker.js",
    "redis": "docker compose up redis"
  },
  "dependencies": {
    "axios": "^1.13.3",
    "fs-extra": "^11.3.3",
    "simple-git": "^3.30.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
